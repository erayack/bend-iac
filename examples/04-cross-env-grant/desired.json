{
  "version": 1,
  "kind": "bend-infra/desired",
  "environments": ["staging", "production"],
  "resources": [
    {
      "type": "d1_database",
      "id": "prod-db",
      "environment": "production",
      "location": "enam",
      "readReplication": "auto",
      "protected": true
    },
    {
      "type": "worker",
      "id": "prod-api",
      "environment": "production",
      "main": "src/api.ts",
      "compatibilityDate": "2026-09-01",
      "bindings": [{ "name": "DB", "database": "prod-db" }]
    }
  ]
}
