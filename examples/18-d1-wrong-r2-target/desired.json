{
  "version": 1,
  "kind": "bend-infra/desired",
  "environments": ["staging", "production"],
  "resources": [
    {
      "type": "r2_bucket",
      "id": "assets",
      "environment": "staging",
      "protected": false
    },
    {
      "type": "worker",
      "id": "api",
      "environment": "staging",
      "main": "worker.js",
      "compatibilityDate": "2026-01-01",
      "bindings": [
        {
          "name": "DB",
          "database": "assets"
        }
      ]
    }
  ]
}
