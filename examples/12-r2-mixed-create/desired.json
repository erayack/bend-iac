{
  "version": 1,
  "kind": "bend-infra/desired",
  "environments": ["staging", "production"],
  "resources": [
    {
      "type": "worker",
      "id": "api",
      "environment": "staging",
      "main": "src/api.ts",
      "compatibilityDate": "2026-09-01",
      "bindings": [
        {
          "name": "DB",
          "database": "app-db"
        },
        {
          "name": "ASSETS",
          "bucket": "assets"
        }
      ]
    },
    {
      "type": "d1_database",
      "id": "app-db",
      "environment": "staging",
      "location": "weur",
      "readReplication": "disabled",
      "protected": false
    },
    {
      "type": "r2_bucket",
      "id": "assets",
      "environment": "staging",
      "protected": false
    }
  ]
}
