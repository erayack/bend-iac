{
  "version": 1,
  "kind": "bend-infra/desired",
  "environments": ["staging", "production"],
  "resources": [
    {
      "type": "d1_database",
      "id": "app-db",
      "environment": "staging",
      "location": "enam",
      "readReplication": "disabled",
      "protected": false
    },
    {
      "type": "worker",
      "id": "api",
      "environment": "staging",
      "main": "worker.js",
      "compatibilityDate": "2026-01-01",
      "bindings": [
        {
          "name": "ASSETS",
          "bucket": "app-db"
        }
      ]
    }
  ]
}
