{
  "name": "bend-iac",
  "version": "0.1.0",
  "private": true,
  "description": "Proof-oriented infrastructure-as-code planner in Bend 2 for Cloudflare",
  "bin": {
    "bend-iac": "./bin/bend-iac",
    "bend-infra": "./bin/bend-infra"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "scripts/bootstrap.sh",
    "build": "bun scripts/build.ts",
    "check:proofs": "bun scripts/check-proofs.ts",
    "test:e2e": "bun scripts/test-lane.ts e2e",
    "test:integration": "bun scripts/test-lane.ts integration",
    "test:mutation": "bun scripts/mutation.ts",
    "test:live": "bun scripts/test-live.ts",
    "test": "bun scripts/test-all.ts",
    "demo": "bun scripts/demo.ts",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "fmt": "bun --bun oxfmt",
    "fmt:check": "bun --bun oxfmt --check",
    "typecheck": "bun --bun tsc -p tsconfig.json",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "1.3.12",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.12"
  }
}
